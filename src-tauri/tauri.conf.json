{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Tracker Overlay",
  "version": "0.1.2",
  "identifier": "com.vinh1.usage-tracker-overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Usage Tracker",
        "width": 326,
        "height": 190,
        "minWidth": 48,
        "minHeight": 48,
        "maxWidth": 2048,
        "maxHeight": 2048,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Usage Tracker Settings",
        "width": 600,
        "height": 560,
        "minWidth": 540,
        "minHeight": 500,
        "maxWidth": 720,
        "maxHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
